# MAHARANI frontend environment (copy to frontend/.env for local development).
# Every VITE_* variable is embedded in the public browser bundle: never put
# Django secrets, database URLs or API keys here.

# Public base URL of the Django/Wagtail API.
#   development: leave empty - the Vite dev server proxies /api and /media
#   production (Vercel): https://<your-backend>.up.railway.app  (https, no trailing slash)
VITE_API_BASE_URL=

# Dev-only: where the Vite proxy forwards /api and /media.
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Public URL of this frontend, used for canonical and OpenGraph URLs.
#   production (Vercel): https://<your-domain>  (no trailing slash)
VITE_SITE_URL=http://localhost:5173

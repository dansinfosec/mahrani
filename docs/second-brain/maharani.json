{
  "project": {
    "name": "MAHARANI",
    "type": "luxury beauty ecommerce",
    "hero_product": "MAHARANI Luxury Makeup Kit (multi-layer makeup box, LED mirror, touch control, three drawers)",
    "visual_language": ["black lacquer", "warm black", "rose gold", "champagne", "ivory", "warm LED glow"],
    "collaboration": {
      "configurable": true,
      "default_enabled": false,
      "storage": "cms.SiteSettings (collaboration_enabled, collaboration_label, collaboration_partner_name, collaboration_logo, collaboration_disclaimer)",
      "partner_named_in_code": false
    },
    "status_summary": {
      "done": ["backend", "cms", "catalog", "cart", "commerce models", "api", "frontend", "homepage", "product page", "story page", "search", "bag drawer", "seo", "responsive", "seed", "railway config", "vercel config", "deployment docs"],
      "partial": ["media storage (volume works, S3/R2 untested)", "product imagery (collage crops)", "search (icontains)", "scroll reveal (stills only)", "wagtail preview (placeholder)"],
      "phase_2": ["checkout", "payments", "customer accounts", "production assets", "object storage default", "headless preview", "analytics", "sitemap/robots", "collections"],
      "not_started": ["payment provider integration", "order creation from cart", "emails", "discounts", "tests suite", "i18n"]
    },
    "snapshot_date": "2026-09-13"
  },
  "architecture": {
    "layers": ["Browser", "Vercel (React SPA)", "Railway (Django REST API + Wagtail)", "Railway PostgreSQL"],
    "separation": {
      "content": "Wagtail (cms app): pages, StreamField blocks, images, site settings",
      "commerce": "Django apps: catalog, cart, orders, customers, payments, shipping",
      "presentation": "React 19 SPA consuming JSON"
    },
    "frontend_to_backend": "fetch to VITE_API_BASE_URL + /api/v1; dev uses Vite proxy for /api and /media",
    "page_routing": "Django page URLs redirect to FRONTEND_URL; React Router owns /, /products/:slug, /account, /:slug"
  },
  "services": [
    {"id": "vercel", "role": "frontend hosting", "root_directory": "frontend", "framework": "vite", "build": "npm run build", "output": "dist", "config": "frontend/vercel.json"},
    {"id": "railway-web", "role": "backend service", "root_directory": "backend", "builder": "NIXPACKS", "start": "sh start.sh", "healthcheck": "/health/", "config": "backend/railway.json"},
    {"id": "railway-postgres", "role": "database", "provides": "DATABASE_URL"},
    {"id": "object-storage", "role": "optional media storage (Cloudflare R2 / S3)", "enabled_by": "AWS_STORAGE_BUCKET_NAME", "status": "implemented, untested"}
  ],
  "apps": [
    {"name": "cms", "responsibility": "content", "models": ["HomePage", "StandardPage", "SiteSettings"], "modules": ["blocks.py", "images.py", "api/views.py", "management/commands/seed_maharani.py"]},
    {"name": "catalog", "responsibility": "commerce", "models": ["Product", "ProductImage", "ProductFeature", "ProductSpecification", "ProductLayer", "ProductVariant"], "modules": ["choosers.py", "blocks.py", "wagtail_hooks.py", "api/serializers.py", "api/views.py"]},
    {"name": "cart", "responsibility": "commerce", "models": ["Cart", "CartItem"], "modules": ["api/views.py"]},
    {"name": "orders", "responsibility": "commerce", "models": ["Order", "OrderItem"], "modules": ["admin.py"]},
    {"name": "customers", "responsibility": "commerce", "models": ["Customer", "Address"], "modules": ["admin.py"]},
    {"name": "payments", "responsibility": "commerce", "models": ["Payment"], "modules": ["admin.py"]},
    {"name": "shipping", "responsibility": "commerce", "models": ["ShippingMethod"], "modules": ["api/views.py"]}
  ],
  "models": [
    {"app": "cms", "name": "HomePage", "base": "wagtail Page + SeoMixin + HeadlessPageMixin", "fields": ["body (StreamField PAGE_BLOCKS)", "og_title", "og_description", "og_image", "canonical_url", "no_index"], "constraints": ["max_count=1", "parent: wagtailcore.Page", "children: cms.StandardPage"]},
    {"app": "cms", "name": "StandardPage", "base": "wagtail Page + SeoMixin + HeadlessPageMixin", "fields": ["intro", "body (StreamField PAGE_BLOCKS)", "og_title", "og_description", "og_image", "canonical_url", "no_index"]},
    {"app": "cms", "name": "SiteSettings", "base": "BaseSiteSetting", "fields": ["brand_name", "tagline", "announcement_enabled", "announcement_text", "navigation (StreamField of LinkBlock)", "featured_product (FK catalog.Product)", "collaboration_enabled", "collaboration_label", "collaboration_partner_name", "collaboration_logo", "collaboration_disclaimer", "footer_tagline", "footer_links", "instagram_url", "tiktok_url", "contact_email", "copyright_text", "seo_title_suffix", "default_meta_description", "default_og_image"]},
    {"app": "catalog", "name": "Product", "base": "ClusterableModel", "fields": ["name", "slug", "product_type", "collaboration_label", "short_description", "description (RichText)", "price", "compare_at_price", "currency", "sku", "stock_quantity", "low_stock_threshold", "is_active", "is_featured", "primary_image (FK wagtailimages.Image)", "height_cm", "width_cm", "depth_cm", "weight_grams", "dimensions_note", "materials", "shipping_information (RichText)", "created_at", "updated_at"], "derived": ["in_stock", "is_low_stock", "is_on_sale", "dimensions"]},
    {"app": "catalog", "name": "ProductImage", "fields": ["product (ParentalKey)", "image", "alt_text", "caption", "sort_order"]},
    {"app": "catalog", "name": "ProductFeature", "fields": ["product", "icon", "title", "description", "sort_order"]},
    {"app": "catalog", "name": "ProductSpecification", "fields": ["product", "label", "value", "sort_order"]},
    {"app": "catalog", "name": "ProductLayer", "fields": ["product", "number", "name", "title", "description", "contents", "image", "sort_order"], "derived": ["content_items"]},
    {"app": "catalog", "name": "ProductVariant", "fields": ["product", "name", "sku", "price (nullable)", "stock_quantity", "is_active", "sort_order"], "derived": ["effective_price"]},
    {"app": "cart", "name": "Cart", "fields": ["token (UUID unique)", "customer (FK customers.Customer, nullable)", "currency", "status", "created_at", "updated_at"], "derived": ["item_count", "subtotal"]},
    {"app": "cart", "name": "CartItem", "fields": ["cart", "product (PROTECT)", "variant (nullable, PROTECT)", "quantity", "unit_price", "created_at", "updated_at"], "constraints": ["unique (cart, product, variant)"], "derived": ["available_stock", "current_price", "line_total"]},
    {"app": "orders", "name": "Order", "fields": ["number", "status", "customer", "cart (OneToOne)", "email", "phone", "currency", "subtotal", "shipping_total", "tax_total", "discount_total", "total", "shipping_method", "shipping_name", "shipping_line1", "shipping_line2", "shipping_city", "shipping_region", "shipping_postal_code", "shipping_country", "notes", "created_at", "updated_at"]},
    {"app": "orders", "name": "OrderItem", "fields": ["order", "product (SET_NULL)", "variant (SET_NULL)", "product_name", "sku", "unit_price", "quantity"], "derived": ["line_total"]},
    {"app": "customers", "name": "Customer", "fields": ["user (OneToOne, nullable)", "email (unique)", "first_name", "last_name", "phone", "accepts_marketing", "created_at", "updated_at"]},
    {"app": "customers", "name": "Address", "fields": ["customer", "label", "name", "line1", "line2", "city", "region", "postal_code", "country", "phone", "is_default"]},
    {"app": "payments", "name": "Payment", "fields": ["order", "provider (stripe|manual)", "status (pending|authorized|captured|failed|refunded)", "amount", "currency", "provider_reference", "raw_response (JSON)", "created_at", "updated_at"], "note": "records only; no processing"},
    {"app": "shipping", "name": "ShippingMethod", "fields": ["name", "description", "price", "currency", "estimated_min_days", "estimated_max_days", "countries", "is_active", "sort_order"], "derived": ["is_free", "country_codes"]}
  ],
  "api_endpoints": [
    {"method": "GET", "path": "/health/", "purpose": "Railway health check, no DB", "auth": "none", "view": "config.api_v1.health"},
    {"method": "GET", "path": "/api/v1/health/", "purpose": "health check under API prefix", "auth": "none", "view": "config.api_v1.health"},
    {"method": "GET", "path": "/api/v1/site/", "purpose": "site settings: navigation, announcement, featured product, collaboration, footer, SEO defaults", "auth": "none", "view": "cms.api.views.SiteSettingsView"},
    {"method": "GET", "path": "/api/v1/pages/home/", "purpose": "home page with StreamField body", "auth": "none", "view": "cms.api.views.HomePageView"},
    {"method": "GET", "path": "/api/v1/pages/<slug>/", "purpose": "live public page by slug", "auth": "none", "view": "cms.api.views.PageBySlugView"},
    {"method": "GET", "path": "/api/v1/products/", "purpose": "active products (limit/offset pagination; ?featured=1; ?q=term)", "auth": "none", "view": "catalog.api.views.ProductViewSet.list"},
    {"method": "GET", "path": "/api/v1/products/<slug>/", "purpose": "product detail", "auth": "none", "view": "catalog.api.views.ProductViewSet.retrieve"},
    {"method": "GET", "path": "/api/v1/shipping/methods/", "purpose": "active shipping methods (?country=XX)", "auth": "none", "view": "shipping.api.views.ShippingMethodListView"},
    {"method": "GET", "path": "/api/v1/cart/", "purpose": "current cart or empty shape", "auth": "X-Cart-Token header (optional)", "view": "cart.api.views.CartView"},
    {"method": "DELETE", "path": "/api/v1/cart/", "purpose": "clear cart", "auth": "X-Cart-Token header", "view": "cart.api.views.CartView"},
    {"method": "POST", "path": "/api/v1/cart/items/", "purpose": "add {product slug, quantity, variant_id?}; creates cart; returns token in body + X-Cart-Token header", "auth": "X-Cart-Token header (optional)", "view": "cart.api.views.CartItemsView"},
    {"method": "PATCH", "path": "/api/v1/cart/items/<id>/", "purpose": "set quantity (0 removes, max 10, stock-clamped)", "auth": "X-Cart-Token header (required)", "view": "cart.api.views.CartItemDetailView"},
    {"method": "DELETE", "path": "/api/v1/cart/items/<id>/", "purpose": "remove line", "auth": "X-Cart-Token header (required)", "view": "cart.api.views.CartItemDetailView"},
    {"method": "GET", "path": "/api/v2/pages/", "purpose": "Wagtail API v2 pages", "auth": "none", "view": "wagtail.api.v2.views.PagesAPIViewSet"},
    {"method": "GET", "path": "/api/v2/images/", "purpose": "Wagtail API v2 images", "auth": "none", "view": "wagtail.images.api.v2.views.ImagesAPIViewSet"},
    {"method": "GET", "path": "/admin/", "purpose": "Wagtail admin", "auth": "Django session"},
    {"method": "GET", "path": "/django-admin/", "purpose": "Django admin", "auth": "Django session"},
    {"method": "GET", "path": "/media/<path>", "purpose": "uploaded media when stored on local disk/volume", "auth": "none"}
  ],
  "cms_blocks": [
    {"type": "hero", "class": "HeroBlock", "component": "frontend/src/components/blocks/Hero.jsx"},
    {"type": "editorial_text", "class": "EditorialTextBlock", "component": "EditorialText.jsx"},
    {"type": "image_text", "class": "ImageTextBlock", "component": "ImageText.jsx"},
    {"type": "video", "class": "VideoBlock", "component": "Video.jsx"},
    {"type": "product_reveal", "class": "ProductRevealBlock", "component": "ProductReveal.jsx", "references": "catalog.Product (optional)"},
    {"type": "features", "class": "FeatureBlock", "component": "Features.jsx"},
    {"type": "drawer_showcase", "class": "DrawerShowcaseBlock", "component": "DrawerShowcase.jsx", "references": "catalog.Product layers"},
    {"type": "spotlight", "class": "SpotlightBlock", "component": "Spotlight.jsx"},
    {"type": "product_details", "class": "ProductDetailsBlock", "component": "ProductDetails.jsx", "references": "catalog.Product specifications/dimensions/materials"},
    {"type": "product_purchase", "class": "ProductPurchaseBlock", "component": "ProductPurchase.jsx", "references": "catalog.Product (full detail JSON)"},
    {"type": "gallery", "class": "GalleryBlock", "component": "Gallery.jsx"},
    {"type": "quote", "class": "QuoteBlock", "component": "Quote.jsx"},
    {"type": "reviews", "class": "ReviewBlock", "component": "Reviews.jsx"},
    {"type": "brand_story", "class": "BrandStoryBlock", "component": "BrandStory.jsx"},
    {"type": "cta_section", "class": "CTASectionBlock", "component": "CTASection.jsx"},
    {"type": "faq", "class": "FAQBlock", "component": "FAQ.jsx"}
  ],
  "environment_variables": [
    {"name": "DJANGO_SETTINGS_MODULE", "scope": "backend", "required_in_production": true, "production_value_shape": "config.settings.production"},
    {"name": "SECRET_KEY", "scope": "backend", "required_in_production": true, "secret": true},
    {"name": "DEBUG", "scope": "backend", "required_in_production": false, "note": "dev only; production forces False"},
    {"name": "ALLOWED_HOSTS", "scope": "backend", "required_in_production": true, "format": "comma-separated hosts"},
    {"name": "DATABASE_URL", "scope": "backend/railway", "required_in_production": true, "secret": true, "note": "postgres:// only in production"},
    {"name": "DB_CONN_MAX_AGE", "scope": "backend", "required_in_production": false},
    {"name": "TIME_ZONE", "scope": "backend", "required_in_production": false},
    {"name": "LOG_LEVEL", "scope": "backend", "required_in_production": false},
    {"name": "WAGTAILADMIN_BASE_URL", "scope": "backend", "required_in_production": true, "note": "public https backend URL"},
    {"name": "FRONTEND_URL", "scope": "backend", "required_in_production": true},
    {"name": "CORS_ALLOWED_ORIGINS", "scope": "backend", "required_in_production": true, "format": "comma-separated origins"},
    {"name": "CSRF_TRUSTED_ORIGINS", "scope": "backend", "required_in_production": true, "format": "comma-separated origins"},
    {"name": "MEDIA_ROOT", "scope": "backend/railway", "required_in_production": false, "note": "volume mount path for local media mode"},
    {"name": "AWS_STORAGE_BUCKET_NAME", "scope": "backend", "required_in_production": false, "note": "enables S3/R2 media"},
    {"name": "AWS_ACCESS_KEY_ID", "scope": "backend", "secret": true, "required_in_production": false},
    {"name": "AWS_SECRET_ACCESS_KEY", "scope": "backend", "secret": true, "required_in_production": false},
    {"name": "AWS_S3_ENDPOINT_URL", "scope": "backend", "required_in_production": false},
    {"name": "AWS_S3_REGION_NAME", "scope": "backend", "required_in_production": false},
    {"name": "AWS_S3_CUSTOM_DOMAIN", "scope": "backend", "required_in_production": false},
    {"name": "SHOP_CURRENCY", "scope": "backend", "required_in_production": false},
    {"name": "API_ANON_THROTTLE", "scope": "backend", "required_in_production": false},
    {"name": "SECURE_SSL_REDIRECT", "scope": "backend", "required_in_production": false},
    {"name": "SECURE_HSTS_SECONDS", "scope": "backend", "required_in_production": false},
    {"name": "SECURE_HSTS_INCLUDE_SUBDOMAINS", "scope": "backend", "required_in_production": false},
    {"name": "SECURE_HSTS_PRELOAD", "scope": "backend", "required_in_production": false},
    {"name": "EMAIL_BACKEND", "scope": "backend", "required_in_production": false},
    {"name": "DEFAULT_FROM_EMAIL", "scope": "backend", "required_in_production": false},
    {"name": "PORT", "scope": "railway", "injected": true},
    {"name": "WEB_CONCURRENCY", "scope": "railway", "required_in_production": false},
    {"name": "GUNICORN_THREADS", "scope": "railway", "required_in_production": false},
    {"name": "GUNICORN_TIMEOUT", "scope": "railway", "required_in_production": false},
    {"name": "GUNICORN_LOG_LEVEL", "scope": "railway", "required_in_production": false},
    {"name": "DEV_ADMIN_PASSWORD", "scope": "backend dev seed", "required_in_production": false, "note": "never used when DEBUG=False"},
    {"name": "VITE_API_BASE_URL", "scope": "frontend/vercel", "required_in_production": true, "public": true},
    {"name": "VITE_SITE_URL", "scope": "frontend/vercel", "required_in_production": true, "public": true},
    {"name": "VITE_DEV_API_PROXY", "scope": "frontend dev", "required_in_production": false, "public": true}
  ],
  "deployment": {
    "source_control": "GitHub repository (frontend/ and backend/)",
    "frontend": {"platform": "Vercel", "root_directory": "frontend", "framework": "Vite", "install": "npm ci", "build": "npm run build", "output": "dist", "spa_rewrite": "/((?!assets/).*) -> /index.html", "env": ["VITE_API_BASE_URL", "VITE_SITE_URL"]},
    "backend": {"platform": "Railway", "root_directory": "backend", "builder": "Nixpacks", "python": "3.12 (.python-version)", "start": "sh start.sh (migrate --noinput, collectstatic --noinput, gunicorn config.wsgi:application)", "healthcheck": "/health/", "static": "WhiteNoise CompressedManifestStaticFilesStorage", "media": "volume at MEDIA_ROOT (MVP) or S3/R2 via AWS_* vars"},
    "database": {"platform": "Railway PostgreSQL", "wiring": "DATABASE_URL=${{Postgres.DATABASE_URL}}", "sqlite_in_production": "refused by settings"},
    "admin_bootstrap": "python manage.py createsuperuser (Railway shell); seed_maharani creates content only when DEBUG=False",
    "docs": ["docs/deployment/RAILWAY.md", "docs/deployment/VERCEL.md", "docs/deployment/CHECKLIST.md", "DEPLOYMENT.md"]
  },
  "decisions": [
    {"id": "django-wagtail", "decision": "Django + Wagtail backend", "why": "editor-friendly StreamField sections, image renditions, permissions, revisions"},
    {"id": "react-headless", "decision": "React/Vite headless frontend instead of Wagtail templates", "why": "cinematic motion, SPA interactions, independent Vercel deploys"},
    {"id": "drf", "decision": "Django REST Framework for the project API", "why": "explicit serializers, throttling, pagination, stable JSON contract"},
    {"id": "streamfield", "decision": "Typed StreamField blocks", "why": "predictable {type, value} JSON so React maps block types to components; editors reorder sections"},
    {"id": "commerce-plain-django", "decision": "Commerce as plain Django models, Wagtail only for admin UI/choosers", "why": "transactional data must not be coupled to page revisions"},
    {"id": "server-cart", "decision": "Server-side cart identified by X-Cart-Token", "why": "server is the price/stock authority; header token works cross-origin without cookies"},
    {"id": "vercel", "decision": "Vercel for the frontend", "why": "static SPA hosting, CDN, preview deployments"},
    {"id": "railway", "decision": "Railway for backend and PostgreSQL", "why": "managed Postgres with injected DATABASE_URL, simple Python service, volumes"},
    {"id": "postgres-only-prod", "decision": "PostgreSQL required in production", "why": "no silent SQLite fallback on ephemeral filesystems"},
    {"id": "collab-configurable", "decision": "Collaboration content configurable and OFF by default", "why": "trademark approval; no partner names in code or metadata"},
    {"id": "custom-css", "decision": "Custom CSS design system, no UI library", "why": "luxury brand look relies on bespoke type, spacing and motion"},
    {"id": "no-fake-checkout", "decision": "No checkout/payment code until a real provider is integrated", "why": "avoid misleading placeholder flows"}
  ],
  "dependencies": {
    "backend": ["Django>=5.2,<5.3", "wagtail>=7.0,<7.1", "djangorestframework>=3.16,<3.17", "django-cors-headers>=4.7", "django-environ>=0.12", "psycopg[binary]>=3.2", "gunicorn>=23.0", "whitenoise>=6.9", "Pillow>=11.0", "django-storages[s3]>=1.14"],
    "frontend": ["react ^19.1.1", "react-dom ^19.1.1", "react-router-dom ^7.8.2", "framer-motion ^12.23.12"],
    "frontend_dev": ["vite ^7.1.2", "@vitejs/plugin-react ^5.0.0", "eslint ^9.33.0", "eslint-plugin-react ^7.37.5", "eslint-plugin-react-hooks ^5.2.0", "eslint-plugin-react-refresh ^0.4.20", "globals ^16.3.0", "@eslint/js ^9.33.0"],
    "fonts": ["Cinzel", "Cormorant Garamond", "Jost (Google Fonts)"]
  },
  "phase_2": [
    "Stripe payment provider with webhooks into payments.Payment",
    "Checkout flow creating orders.Order from cart.Cart",
    "Customer accounts (auth, order history, addresses)",
    "Production product photography/renders; layered or sequence media for the reveal",
    "R2/S3 media storage as production default",
    "Wagtail headless live preview",
    "Analytics",
    "Sitemap and robots endpoints",
    "Collections model as catalog grows"
  ],
  "known_constraints": [
    "Imagery derived from the supplied reference collage; final high-resolution assets required",
    "Payment/checkout not implemented (Phase 2)",
    "Customer accounts not implemented (/account is a placeholder)",
    "Collaboration assets require partner approval before enabling",
    "Railway filesystem is ephemeral: use a volume or S3/R2 for media",
    "S3/R2 mode implemented but not tested against a live bucket",
    "Reduced-motion users get static variants; developers use ?motion=1 to preview motion",
    "No automated test suite; gates are Django checks, collectstatic, ESLint and Vite build"
  ]
}

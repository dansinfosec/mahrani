{
  "nodes": [
    {"id": "project:maharani", "type": "project", "label": "MAHARANI", "description": "Luxury beauty ecommerce platform for the MAHARANI Luxury Makeup Kit."},

    {"id": "service:react-frontend", "type": "service", "label": "React frontend", "description": "React 19 + Vite 7 single-page app in frontend/."},
    {"id": "service:django-backend", "type": "service", "label": "Django backend", "description": "Django 5.2 project in backend/ hosting Wagtail, DRF API and commerce apps."},
    {"id": "service:django-api", "type": "service", "label": "Django REST API", "description": "Project API under /api/v1 plus Wagtail API v2 under /api/v2."},

    {"id": "framework:react", "type": "framework", "label": "React 19", "description": "UI library; React 19 head hoisting used for SEO tags."},
    {"id": "framework:vite", "type": "framework", "label": "Vite 7", "description": "Build tool and dev server with /api and /media proxy."},
    {"id": "framework:react-router", "type": "framework", "label": "React Router 7", "description": "Client-side routing: /, /products/:slug, /account, /:slug, *."},
    {"id": "framework:framer-motion", "type": "framework", "label": "Framer Motion 12", "description": "Restrained luxury motion with reduced-motion support."},
    {"id": "framework:django", "type": "framework", "label": "Django 5.2", "description": "Backend web framework."},
    {"id": "framework:wagtail", "type": "framework", "label": "Wagtail 7", "description": "CMS: pages, StreamField, images, site settings, admin."},
    {"id": "framework:drf", "type": "framework", "label": "Django REST Framework", "description": "Serializers, viewsets, throttling, pagination."},
    {"id": "framework:whitenoise", "type": "framework", "label": "WhiteNoise", "description": "Serves collected static files (Django + Wagtail admin) in production."},
    {"id": "framework:gunicorn", "type": "framework", "label": "gunicorn", "description": "WSGI server started by start.sh."},

    {"id": "database:postgresql", "type": "database", "label": "PostgreSQL", "description": "Production database via DATABASE_URL (Railway)."},
    {"id": "database:sqlite", "type": "database", "label": "SQLite (dev only)", "description": "Local fallback when DATABASE_URL is unset; refused by production settings."},

    {"id": "deployment:vercel", "type": "deployment", "label": "Vercel", "description": "Frontend hosting; root frontend/, Vite framework, SPA rewrite in vercel.json."},
    {"id": "deployment:railway-web", "type": "deployment", "label": "Railway web service", "description": "Backend service built with Nixpacks; start.sh runs migrate, collectstatic, gunicorn; health /health/."},
    {"id": "deployment:railway-postgres", "type": "deployment", "label": "Railway PostgreSQL", "description": "Managed Postgres service injecting DATABASE_URL."},
    {"id": "deployment:railway-volume", "type": "deployment", "label": "Railway volume", "description": "Persistent disk mounted at MEDIA_ROOT for MVP media."},
    {"id": "external:object-storage", "type": "external_service", "label": "S3 / Cloudflare R2", "description": "Optional media storage enabled by AWS_STORAGE_BUCKET_NAME (django-storages)."},
    {"id": "external:google-fonts", "type": "external_service", "label": "Google Fonts", "description": "Cinzel, Cormorant Garamond, Jost loaded from fonts.googleapis.com."},
    {"id": "external:github", "type": "external_service", "label": "GitHub", "description": "Source repository connected to Vercel and Railway."},

    {"id": "app:cms", "type": "application", "label": "cms", "description": "Content app: pages, blocks, image serialisation, site settings, content API, seed command."},
    {"id": "app:catalog", "type": "application", "label": "catalog", "description": "Products and related commerce data; Wagtail admin viewset and product chooser."},
    {"id": "app:cart", "type": "application", "label": "cart", "description": "Server-side token-identified cart and API."},
    {"id": "app:orders", "type": "application", "label": "orders", "description": "Order and OrderItem models (Phase 2 checkout target)."},
    {"id": "app:customers", "type": "application", "label": "customers", "description": "Customer and Address models."},
    {"id": "app:payments", "type": "application", "label": "payments", "description": "Payment records; no provider integration yet."},
    {"id": "app:shipping", "type": "application", "label": "shipping", "description": "ShippingMethod model and API."},

    {"id": "model:HomePage", "type": "model", "label": "cms.HomePage", "description": "Site root page with StreamField body and SEO fields; max one."},
    {"id": "model:StandardPage", "type": "model", "label": "cms.StandardPage", "description": "Editorial page (e.g. our-story) sharing the same blocks."},
    {"id": "model:SiteSettings", "type": "model", "label": "cms.SiteSettings", "description": "Navigation, footer, announcement, collaboration content (off by default), SEO defaults."},
    {"id": "model:StreamField", "type": "model", "label": "PAGE_BLOCKS StreamField", "description": "Ordered list of typed section blocks stored as JSON on pages."},
    {"id": "model:WagtailImage", "type": "model", "label": "wagtailimages.Image", "description": "Uploaded images with renditions; serialised by cms/images.py."},
    {"id": "model:Product", "type": "model", "label": "catalog.Product", "description": "Sellable product with price, stock, dimensions, materials, shipping info."},
    {"id": "model:ProductImage", "type": "model", "label": "catalog.ProductImage", "description": "Gallery image with alt override and caption."},
    {"id": "model:ProductFeature", "type": "model", "label": "catalog.ProductFeature", "description": "Icon + title + description selling point."},
    {"id": "model:ProductSpecification", "type": "model", "label": "catalog.ProductSpecification", "description": "Label/value specification row."},
    {"id": "model:ProductLayer", "type": "model", "label": "catalog.ProductLayer", "description": "Drawer/layer with contents list and image."},
    {"id": "model:ProductVariant", "type": "model", "label": "catalog.ProductVariant", "description": "Optional variant with own SKU, price override and stock."},
    {"id": "model:Cart", "type": "model", "label": "cart.Cart", "description": "Token-identified cart with status and optional customer."},
    {"id": "model:CartItem", "type": "model", "label": "cart.CartItem", "description": "Cart line with quantity and unit price snapshot."},
    {"id": "model:Order", "type": "model", "label": "orders.Order", "description": "Order header with totals, status and shipping address."},
    {"id": "model:OrderItem", "type": "model", "label": "orders.OrderItem", "description": "Order line with product snapshots."},
    {"id": "model:Customer", "type": "model", "label": "customers.Customer", "description": "Customer profile, optionally linked to a Django user."},
    {"id": "model:Address", "type": "model", "label": "customers.Address", "description": "Customer address."},
    {"id": "model:Payment", "type": "model", "label": "payments.Payment", "description": "Payment record for an order (stripe/manual), no processing."},
    {"id": "model:ShippingMethod", "type": "model", "label": "shipping.ShippingMethod", "description": "Shipping option with price and delivery estimate."},

    {"id": "api:health", "type": "api_endpoint", "label": "GET /health/", "description": "Health check without DB access; also at /api/v1/health/."},
    {"id": "api:site", "type": "api_endpoint", "label": "GET /api/v1/site/", "description": "Site settings JSON."},
    {"id": "api:pages-home", "type": "api_endpoint", "label": "GET /api/v1/pages/home/", "description": "Home page with serialised StreamField body."},
    {"id": "api:pages-slug", "type": "api_endpoint", "label": "GET /api/v1/pages/<slug>/", "description": "Live page by slug."},
    {"id": "api:products", "type": "api_endpoint", "label": "GET /api/v1/products/", "description": "Product list with ?featured and ?q filters."},
    {"id": "api:product-detail", "type": "api_endpoint", "label": "GET /api/v1/products/<slug>/", "description": "Product detail."},
    {"id": "api:shipping-methods", "type": "api_endpoint", "label": "GET /api/v1/shipping/methods/", "description": "Active shipping methods."},
    {"id": "api:cart", "type": "api_endpoint", "label": "GET/DELETE /api/v1/cart/", "description": "Read or clear the token-identified cart."},
    {"id": "api:cart-items", "type": "api_endpoint", "label": "POST /api/v1/cart/items/", "description": "Add a product line; creates the cart and returns X-Cart-Token."},
    {"id": "api:cart-item", "type": "api_endpoint", "label": "PATCH/DELETE /api/v1/cart/items/<id>/", "description": "Update quantity or remove a line."},
    {"id": "api:wagtail-v2", "type": "api_endpoint", "label": "GET /api/v2/pages|images", "description": "Standard Wagtail API v2."},
    {"id": "api:wagtail-admin", "type": "api_endpoint", "label": "/admin/", "description": "Wagtail admin (session auth)."},

    {"id": "block:hero", "type": "cms_block", "label": "hero", "description": "HeroBlock: title, tagline, headline, image, CTAs."},
    {"id": "block:editorial_text", "type": "cms_block", "label": "editorial_text", "description": "EditorialTextBlock."},
    {"id": "block:image_text", "type": "cms_block", "label": "image_text", "description": "ImageTextBlock."},
    {"id": "block:video", "type": "cms_block", "label": "video", "description": "VideoBlock."},
    {"id": "block:product_reveal", "type": "cms_block", "label": "product_reveal", "description": "ProductRevealBlock: scroll-driven stages with media_mode hooks."},
    {"id": "block:features", "type": "cms_block", "label": "features", "description": "FeatureBlock."},
    {"id": "block:drawer_showcase", "type": "cms_block", "label": "drawer_showcase", "description": "DrawerShowcaseBlock: layers from product or custom."},
    {"id": "block:spotlight", "type": "cms_block", "label": "spotlight", "description": "SpotlightBlock: LED mirror glow section."},
    {"id": "block:product_details", "type": "cms_block", "label": "product_details", "description": "ProductDetailsBlock: specs, dimensions, materials from product."},
    {"id": "block:product_purchase", "type": "cms_block", "label": "product_purchase", "description": "ProductPurchaseBlock: embeds product JSON for the purchase panel."},
    {"id": "block:gallery", "type": "cms_block", "label": "gallery", "description": "GalleryBlock."},
    {"id": "block:quote", "type": "cms_block", "label": "quote", "description": "QuoteBlock."},
    {"id": "block:reviews", "type": "cms_block", "label": "reviews", "description": "ReviewBlock."},
    {"id": "block:brand_story", "type": "cms_block", "label": "brand_story", "description": "BrandStoryBlock: Beauty • Elegance • You."},
    {"id": "block:cta_section", "type": "cms_block", "label": "cta_section", "description": "CTASectionBlock."},
    {"id": "block:faq", "type": "cms_block", "label": "faq", "description": "FAQBlock."},

    {"id": "page:home", "type": "page", "label": "HomePage.jsx (/)", "description": "Fetches /api/v1/pages/home/ and renders blocks via BlockRenderer."},
    {"id": "page:product", "type": "page", "label": "ProductPage.jsx (/products/:slug)", "description": "Fetches product detail; gallery, PurchasePanel, features, layers, specs, JSON-LD."},
    {"id": "page:standard", "type": "page", "label": "StandardPage.jsx (/:slug)", "description": "Renders CMS pages such as /our-story/."},
    {"id": "page:account", "type": "page", "label": "AccountPage.jsx (/account)", "description": "Placeholder until customer accounts ship."},
    {"id": "page:notfound", "type": "page", "label": "NotFoundPage.jsx (*)", "description": "404 state."},

    {"id": "component:BlockRenderer", "type": "component", "label": "BlockRenderer", "description": "Maps block.type to section components."},
    {"id": "component:Header", "type": "component", "label": "Header", "description": "Transparent → dark blurred header, nav from SiteSettings, search, account, bag."},
    {"id": "component:MobileMenu", "type": "component", "label": "MobileMenu", "description": "Full-screen accessible menu with focus trap."},
    {"id": "component:BagDrawer", "type": "component", "label": "BagDrawer", "description": "Slide-over cart with stepper, remove, subtotal; checkout disabled."},
    {"id": "component:SearchOverlay", "type": "component", "label": "SearchOverlay", "description": "Debounced product search via ?q=."},
    {"id": "component:Footer", "type": "component", "label": "Footer", "description": "Brand, links, collaboration disclaimer when enabled."},
    {"id": "component:PurchasePanel", "type": "component", "label": "PurchasePanel", "description": "Price, availability, variants, quantity, Add to bag, shipping info."},
    {"id": "component:Seo", "type": "component", "label": "Seo", "description": "Title, meta, canonical, OpenGraph, robots, JSON-LD via React 19 head hoisting."},
    {"id": "component:CartContext", "type": "component", "label": "CartProvider / useCart", "description": "Server cart state; persists X-Cart-Token in localStorage."},
    {"id": "component:SiteContext", "type": "component", "label": "SiteProvider / useSite", "description": "Site settings state from /api/v1/site/."},
    {"id": "component:apiClient", "type": "component", "label": "api/client.js", "description": "fetch wrapper; normalises VITE_API_BASE_URL; endpoint map."},
    {"id": "component:designTokens", "type": "component", "label": "styles/tokens.css", "description": "Palette, typography and layout tokens of the design system."},

    {"id": "env:DJANGO_SETTINGS_MODULE", "type": "environment_variable", "label": "DJANGO_SETTINGS_MODULE", "description": "config.settings.production on Railway."},
    {"id": "env:SECRET_KEY", "type": "environment_variable", "label": "SECRET_KEY", "description": "Required secret; production refuses defaults/short keys."},
    {"id": "env:DATABASE_URL", "type": "environment_variable", "label": "DATABASE_URL", "description": "Required postgres:// URL in production."},
    {"id": "env:ALLOWED_HOSTS", "type": "environment_variable", "label": "ALLOWED_HOSTS", "description": "Comma-separated hosts."},
    {"id": "env:CORS_ALLOWED_ORIGINS", "type": "environment_variable", "label": "CORS_ALLOWED_ORIGINS", "description": "Comma-separated frontend origins."},
    {"id": "env:CSRF_TRUSTED_ORIGINS", "type": "environment_variable", "label": "CSRF_TRUSTED_ORIGINS", "description": "Comma-separated trusted origins for admin/CSRF."},
    {"id": "env:WAGTAILADMIN_BASE_URL", "type": "environment_variable", "label": "WAGTAILADMIN_BASE_URL", "description": "Public backend URL used for absolute media URLs."},
    {"id": "env:FRONTEND_URL", "type": "environment_variable", "label": "FRONTEND_URL", "description": "Public frontend URL used for page redirects/canonicals."},
    {"id": "env:MEDIA_ROOT", "type": "environment_variable", "label": "MEDIA_ROOT", "description": "Volume mount path for local media mode."},
    {"id": "env:AWS_STORAGE_BUCKET_NAME", "type": "environment_variable", "label": "AWS_STORAGE_BUCKET_NAME", "description": "Enables S3/R2 media storage with AWS_* companions."},
    {"id": "env:VITE_API_BASE_URL", "type": "environment_variable", "label": "VITE_API_BASE_URL", "description": "Public API base URL baked into the frontend bundle."},
    {"id": "env:VITE_SITE_URL", "type": "environment_variable", "label": "VITE_SITE_URL", "description": "Public frontend URL for canonical/OpenGraph."},

    {"id": "decision:django-wagtail", "type": "decision", "label": "Django + Wagtail", "description": "Editor-friendly content with StreamField, renditions, permissions."},
    {"id": "decision:react-headless", "type": "decision", "label": "Headless React frontend", "description": "Cinematic motion and SPA UX; independent deploys."},
    {"id": "decision:server-cart", "type": "decision", "label": "Server-side cart with X-Cart-Token", "description": "Server is price/stock authority; header works cross-origin."},
    {"id": "decision:postgres-only", "type": "decision", "label": "PostgreSQL required in production", "description": "No silent SQLite fallback."},
    {"id": "decision:collab-off", "type": "decision", "label": "Collaboration content OFF by default", "description": "No partner names in code until approved."},
    {"id": "decision:no-fake-checkout", "type": "decision", "label": "No placeholder payment flow", "description": "Checkout arrives with a real provider."},

    {"id": "roadmap:stripe", "type": "roadmap_item", "label": "Stripe payments", "description": "Phase 2."},
    {"id": "roadmap:checkout", "type": "roadmap_item", "label": "Checkout flow", "description": "Phase 2: cart → order."},
    {"id": "roadmap:accounts", "type": "roadmap_item", "label": "Customer accounts", "description": "Phase 2."},
    {"id": "roadmap:assets", "type": "roadmap_item", "label": "Production product assets", "description": "Phase 2: photography/renders, layered reveal media."},
    {"id": "roadmap:object-storage", "type": "roadmap_item", "label": "R2/S3 media default", "description": "Phase 2."},
    {"id": "roadmap:preview", "type": "roadmap_item", "label": "Wagtail headless preview", "description": "Phase 2 (optional)."},
    {"id": "roadmap:analytics", "type": "roadmap_item", "label": "Analytics", "description": "Phase 2."},
    {"id": "roadmap:sitemap", "type": "roadmap_item", "label": "Sitemap / robots", "description": "Phase 2."},
    {"id": "roadmap:collections", "type": "roadmap_item", "label": "Collections", "description": "Phase 2 when catalog expands."}

# ==========================================================================
# MAHARANI backend environment (copy to backend/.env for local development).
# Only variable NAMES are documented here; never commit real values.
# ==========================================================================

# --- Core ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# production: DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-me-to-a-long-random-string
# production: at least 50 random characters (python -c "import secrets; print(secrets.token_urlsafe(64))")
DEBUG=True
# ignored by production settings (always False there)
ALLOWED_HOSTS=localhost,127.0.0.1
# comma-separated hostnames, e.g. maharani-api.up.railway.app,api.example.com
TIME_ZONE=Asia/Dubai
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# Development: leave unset to use SQLite (backend/db.sqlite3).
# Production: REQUIRED. Railway injects it when the Postgres service is attached
# (reference it as ${{Postgres.DATABASE_URL}}). Production refuses to start
# without it and never falls back to SQLite.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DB_CONN_MAX_AGE=60

# --- Public URLs / cross-origin -----------------------------------------
# Public URL of this backend (absolute media URLs, admin links, Wagtail Site).
WAGTAILADMIN_BASE_URL=http://localhost:8000
# Public URL of the React app (Vercel).
FRONTEND_URL=http://localhost:5173
# Comma-separated origins (scheme + host, no path).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:5173

# --- Media --------------------------------------------------------------
# Default: local filesystem. On Railway mount a volume and point MEDIA_ROOT at it.
# MEDIA_ROOT=/app/media
# Optional S3-compatible storage (Cloudflare R2 / AWS S3). Setting the bucket
# name switches uploads to object storage.
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=            e.g. https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# AWS_S3_CUSTOM_DOMAIN=           e.g. media.example.com (public bucket domain)

# --- Commerce -----------------------------------------------------------
SHOP_CURRENCY=USD
# API_ANON_THROTTLE=600/min

# --- Production hardening (config.settings.production) -------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=2592000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=MAHARANI <no-reply@example.com>

# --- Process (Railway start.sh; PORT is injected by Railway) --------------
# WEB_CONCURRENCY=2
# GUNICORN_THREADS=2
# GUNICORN_TIMEOUT=120
# GUNICORN_LOG_LEVEL=info

# --- Development seed ----------------------------------------------------
# DEV_ADMIN_PASSWORD=
# dev only; seed_maharani never creates users when DEBUG=False
